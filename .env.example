# Supabase (Project Settings > API). The service role key is server-only: never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Same project, browser-safe values used for sign-in
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Embeddings (text-embedding-3-small, 1536 dimensions)
OPENAI_API_KEY=

# Optional: Firecrawl for JavaScript-heavy sites. If unset, the built-in fetch crawler is used.
FIRECRAWL_API_KEY=

# Protects internal admin routes such as POST /api/crawl
ADMIN_SECRET=change-me

# Public base URL, used when printing connection instructions
APP_URL=http://localhost:3000
