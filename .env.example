# Supabase (Project Settings > API). The service role key is server-only: never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Same project, browser-safe values used for sign-in
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Firecrawl for JavaScript-heavy sites. If unset, the built-in fetch crawler is used.
FIRECRAWL_API_KEY=

# Protects internal admin routes such as POST /api/crawl
ADMIN_SECRET=change-me

# Set by Vercel for cron jobs; any long random string locally
CRON_SECRET=change-me

# Kydos staff who can see and manage every client business (comma separated)
AGENCY_EMAILS=kydosdigital@gmail.com

# Public base URL for connection instructions. Optional on Vercel: defaults to the production domain.
APP_URL=http://localhost:3000
